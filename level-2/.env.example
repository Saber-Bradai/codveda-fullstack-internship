# Copy to .env and adjust. If MONGO_URI is empty, an in-memory MongoDB is started automatically (dev only).
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/codveda_level2
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Test/dev admin account created by `npm run seed` (and automatically with the in-memory DB)
ADMIN_EMAIL=admin@codveda.test
ADMIN_PASSWORD=Admin@12345
