# Copy to .env. Leave MONGO_URI empty in development to use an in-memory MongoDB (auto-seeded).
PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed frontend origins (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Dev/test admin + member accounts created by the seed
ADMIN_EMAIL=admin@codveda.test
ADMIN_PASSWORD=Admin@12345
DEMO_EMAIL=member@codveda.test
DEMO_PASSWORD=Member@12345
